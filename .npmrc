# Resolve any dependency that is not pinned in package-lock.json to the newest
# version published on or before this date. `lerna bootstrap --hoist` installs
# packages outside the lockfile, so without this, ranges like
# "@deriv/api-types": "^1.0.118" and webpack float to today's releases
# (Netlify built with webpack 5.112.2 and newer API types, which fail
# type-checking in @deriv/trader). This is the date of the last upstream
# dependency update to this code. Change it only to move all floating
# dependencies forward or back together.
before=2024-04-01T00:00:00.000Z
